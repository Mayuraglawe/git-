# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Development server configuration
PORT=8080
NODE_ENV=development

# Application settings
APP_NAME=Py-Gram 2k25
APP_VERSION=1.0.0
API_PREFIX=/api

# Basic API test message
PING_MESSAGE=Py-Gram 2k25 API is running!

# ============================================================================
# ACADEMIC SYSTEM CONFIGURATION
# ============================================================================

# Academic year settings
DEFAULT_ACADEMIC_YEAR=2024-2025
ACADEMIC_YEAR_START_MONTH=7
WORKING_DAYS_PER_WEEK=6
MAX_PERIODS_PER_DAY=8

# Class timing configuration
CLASS_DURATION_MINUTES=60
LAB_DURATION_MINUTES=120
LUNCH_BREAK_DURATION=60
TEA_BREAK_DURATION=15

# Timetable generation settings
DEFAULT_QUALITY_THRESHOLD=0.75
MAX_GENERATION_TIME_SECONDS=300
CONFLICT_DETECTION_ENABLED=true
AUTO_SAVE_INTERVAL=30000

# ============================================================================
# TELEGRAM BOT CONFIGURATION (Optional)
# ============================================================================

# Telegram bot for notifications (if implemented)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_PRINCIPAL_CHAT_ID=your-principal-chat-id-here
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# Email service for notifications
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email templates
FROM_EMAIL=noreply@pygram2k25.edu
SUPPORT_EMAIL=support@pygram2k25.edu

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# JWT settings (if using custom auth)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session configuration
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=86400000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# File upload settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
UPLOAD_PATH=./uploads

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Error tracking
ERROR_REPORTING_ENABLED=false
SENTRY_DSN=your-sentry-dsn-here

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Development flags
DEBUG_MODE=true
VERBOSE_LOGGING=false
MOCK_DATA_ENABLED=false
API_DOCUMENTATION_ENABLED=true

# Database debugging
DB_QUERY_LOGGING=false
DB_CONNECTION_LOGGING=false

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================

# Cache configuration
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Database connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# ============================================================================
# COLLEGE-SPECIFIC SETTINGS
# ============================================================================

# Institution details
COLLEGE_NAME=Your College Name
COLLEGE_CODE=YCN
COLLEGE_ADDRESS=Your College Address
COLLEGE_PHONE=+91-XXXXXXXXXX
COLLEGE_EMAIL=info@yourcollege.edu
COLLEGE_WEBSITE=https://yourcollege.edu

# Default settings
DEFAULT_CLASS_DURATION=60
DEFAULT_LAB_DURATION=120
DEFAULT_SEMESTER_COUNT=8
DEFAULT_YEAR_COUNT=4

# Department limits
MAX_DEPARTMENTS=20
MAX_FACULTY_PER_DEPARTMENT=50
MAX_SUBJECTS_PER_DEPARTMENT=100
MAX_CLASSROOMS=200

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Module enablement
TIMETABLE_MODULE_ENABLED=true
EVENT_MANAGEMENT_ENABLED=true
FACULTY_MANAGEMENT_ENABLED=true
STUDENT_MANAGEMENT_ENABLED=true
CONFLICT_RESOLUTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
NOTIFICATION_SYSTEM_ENABLED=true
REPORT_GENERATION_ENABLED=true

# Advanced features
AI_TIMETABLE_GENERATION=false
REAL_TIME_UPDATES=true
MOBILE_APP_SUPPORT=false
CALENDAR_INTEGRATION=false